<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ABC.Retail</RootNamespace>
		<AssemblyName>ABC.Retail</AssemblyName>
		<Version>1.0.0</Version>
		<InvariantGlobalization>false</InvariantGlobalization>

		<!--
      ABC.Retail.Functions is a separate project stored beneath this folder.
      Exclude the entire Functions project from the MVC project's default
      file discovery/compilation.
    -->
		<DefaultItemExcludes>
			$(DefaultItemExcludes);ABC.Retail.Functions\**
		</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
		<PackageReference Include="Azure.Storage.Files.Shares" Version="12.27.1" />
		<PackageReference Include="Azure.Storage.Queues" Version="12.27.1" />
	</ItemGroup>

</Project>