@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="page-head"><p class="eyebrow">AZURE TABLES • CUSTOMERS</p><h1>Customer records</h1><p>Customer information is persisted as entities in Azure Table Storage.</p></div>
<div class="grid-2"><section class="panel"><h2>Add customer</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Name<input name="Name" maxlength="100" required /></label><label>Email<input name="Email" type="email" maxlength="160" required /></label><label>Phone<input name="Phone" maxlength="30" required /></label><label>City<input name="City" maxlength="80" required /></label></div><button class="button primary">Save to Azure Tables</button></form></section>
<section class="panel"><h2>Records (@Model.Count())</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>City</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td><b>@c.Name</b></td><td>@c.Email</td><td>@c.Phone</td><td>@c.City</td><td><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@c.RowKey"/><button class="button small danger" type="submit">Delete</button></form></td></tr>}</tbody></table></div></section></div>
