@model IEnumerable<QueueMessageVm>
@{ ViewData["Title"] = "Queue"; }
<div class="page-head"><p class="eyebrow">AZURE QUEUE STORAGE</p><h1>Order processing queue</h1><p>Queue messages provide a reliable asynchronous boundary between order capture, processing and inventory work.</p></div>
<section class="panel"><h2>Send test message</h2><form asp-action="Send" method="post" class="inline-form"><input name="message" maxlength="800" placeholder="e.g. Processing order ORD-10006" required /><button class="button primary">Send message</button></form></section>
<section class="panel" style="margin-top:18px"><h2>Peeked messages (@Model.Count())</h2><p class="muted">Peek displays messages without removing them. This is useful for assignment evidence.</p><div class="table-wrap"><table><thead><tr><th>Message ID</th><th>Message</th><th>Inserted</th><th>Expires</th></tr></thead><tbody>@foreach(var q in Model){<tr><td><code>@q.MessageId</code></td><td><code class="message">@q.Text</code></td><td>@q.InsertionTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td>@q.ExpirationTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table></div></section>
