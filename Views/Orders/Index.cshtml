@model IEnumerable<Order>
@{ ViewData["Title"] = "Orders"; }
<div class="page-head"><p class="eyebrow">AZURE TABLES + QUEUES</p><h1>Order processing</h1><p>Each order is stored in Azure Tables and produces asynchronous ProcessOrder and UpdateInventory messages in Azure Queue Storage.</p></div>
<section class="panel"><h2>Create order</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Customer<input name="CustomerName" maxlength="100" required /></label><label>Product<input name="ProductName" maxlength="120" required /></label><label>Quantity<input name="Quantity" type="number" min="1" value="1" required /></label><label>Unit price (R)<input name="UnitPrice" type="number" step="0.01" min="0" required /></label></div><button class="button primary">Create & queue order</button></form></section>
<section class="panel" style="margin-top:18px"><h2>Orders (@Model.Count())</h2><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Product</th><th>Qty</th><th>Total</th><th>Status</th><th>Created</th></tr></thead><tbody>@foreach(var o in Model){<tr><td><b>@o.OrderNumber</b></td><td>@o.CustomerName</td><td>@o.ProductName</td><td>@o.Quantity</td><td>R @o.Total.ToString("N2")</td><td><span class="badge">@o.Status</span></td><td>@o.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td></tr>}</tbody></table></div></section>
