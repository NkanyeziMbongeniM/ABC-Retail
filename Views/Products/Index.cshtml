@model IEnumerable<Product>
@{ ViewData["Title"] = "Products"; }
<div class="page-head"><p class="eyebrow">AZURE TABLES • INVENTORY</p><h1>Products & inventory</h1><p>Product information and stock quantities are persisted in Azure Tables.</p></div>
<div class="grid-2"><section class="panel"><h2>Add product</h2><form asp-action="Create" method="post"><div class="form-grid"><label>Name<input name="Name" maxlength="120" required /></label><label>Category<input name="Category" maxlength="80" required /></label><label>Price (R)<input name="Price" type="number" step="0.01" min="0" required /></label><label>Stock quantity<input name="StockQuantity" type="number" min="0" required /></label><label class="full">Description<textarea name="Description" rows="3" maxlength="500"></textarea></label></div><button class="button primary">Save to Azure Tables</button></form></section>
<section class="panel"><h2>Inventory (@Model.Count())</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td><b>@p.Name</b><br/><small class="muted">@p.Description</small></td><td>@p.Category</td><td>R @p.Price.ToString("N2")</td><td><span class="badge">@p.StockQuantity</span></td><td><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@p.RowKey"/><button class="button small danger" type="submit">Delete</button></form></td></tr>}</tbody></table></div></section></div>
