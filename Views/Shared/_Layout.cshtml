<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - ABC Retail</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><header class="topbar"><div class="brand"><span class="brand-mark">A</span><div><strong>ABC Retail</strong><small>CLDV7112w Azure Storage Project</small></div></div><nav><a asp-controller="Home" asp-action="Index">Dashboard</a><a asp-controller="Customers" asp-action="Index">Customers</a><a asp-controller="Products" asp-action="Index">Products</a><a asp-controller="Orders" asp-action="Index">Orders</a><a asp-controller="Media" asp-action="Index">Blob Media</a><a asp-controller="Queue" asp-action="Index">Queue</a><a asp-controller="Logs" asp-action="Index">Azure Files</a></nav></header><main class="container">@if(TempData["Success"] is string success){<div class="alert success">@success</div>}@if(TempData["Error"] is string error){<div class="alert error">@error</div>}@RenderBody()</main><footer>ABC Retail • CLDV7112w Project 1 • Azure Tables • Blob Storage • Queue Storage • Azure Files</footer></body></html>
