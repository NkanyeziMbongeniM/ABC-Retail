@model IEnumerable<FileItemVm>
@{ ViewData["Title"] = "Logs"; }
<div class="page-head"><p class="eyebrow">AZURE FILES</p><h1>Application logs</h1><p>Application log files are stored in the Azure Files share rather than on the ephemeral App Service filesystem.</p></div>
<section class="panel"><h2>Stored files (@Model.Count())</h2><div class="table-wrap"><table><thead><tr><th>File</th><th>Size</th><th>Modified</th><th></th></tr></thead><tbody>@foreach(var f in Model){<tr><td><b>@f.Name</b></td><td>@f.Size.ToString("N0") bytes</td><td>@f.LastModified?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td><a class="button small" asp-action="Download" asp-route-name="@f.Name">Download</a></td></tr>}</tbody></table></div></section>
