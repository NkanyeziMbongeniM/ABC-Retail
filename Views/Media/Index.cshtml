@model IEnumerable<BlobItemVm>
@{ ViewData["Title"] = "Media"; }
<div class="page-head"><p class="eyebrow">AZURE BLOB STORAGE</p><h1>Product & multimedia</h1><p>Upload, list and download binary/text content from Azure Blob Storage.</p></div>
<section class="panel"><h2>Upload media</h2><form asp-action="Upload" method="post" enctype="multipart/form-data" class="upload"><input type="file" name="file" required /><button class="button primary">Upload to Blob Storage</button></form><p class="muted">Student demo limit: 25 MB. Example formats: JPG, PNG, SVG, MP4, TXT, JSON, PDF.</p></section>
<section class="panel" style="margin-top:18px"><h2>Stored blobs (@Model.Count())</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Type</th><th>Size</th><th>Modified</th><th>Actions</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><b>@b.Name</b></td><td>@b.ContentType</td><td>@((b.Size ?? 0).ToString("N0")) bytes</td><td>@b.LastModified?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td><a class="button small" asp-action="Download" asp-route-name="@b.Name">Download</a> <form asp-action="Delete" method="post" style="display:inline"><input type="hidden" name="name" value="@b.Name"/><button class="button small danger" type="submit">Delete</button></form></td></tr>}</tbody></table></div></section>
